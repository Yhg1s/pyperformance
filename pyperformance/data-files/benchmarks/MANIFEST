[benchmarks]

# The name in this file is the benchmark's identity: it is what you select on
# the command line and what pyperformance reports it as. It must match the name
# the benchmark's run_benchmark.py passes to runner.bench_*(), or results
# cannot be attributed back to the benchmark that produced them.
#
# Nine benchmarks report SEVERAL rows from one run, so their MANIFEST name is
# necessarily not a result name. Anything joining results to this file needs
# the mapping:
#
#   base64          -> base64_small, base64_large, urlsafe_base64_small,
#                      base32_small, base32_large, base16_small, base16_large,
#                      ascii85_small, ascii85_large, base85_small, base85_large
#   scimark         -> scimark_{fft,lu,monte_carlo,sor,sparse_mat_mult}
#   sympy           -> sympy_{expand,integrate,sum,str}
#   xml_etree       -> xml_etree_{parse,iterparse,generate,process}
#                      (xml_etree_pure_python_* with --no-accelerator)
#   deepcopy        -> deepcopy, deepcopy_reduce, deepcopy_memo
#   logging         -> logging_{silent,simple,format}
#   genshi          -> genshi_{xml,text}
#   pprint          -> pprint_{safe_repr,pformat}
#   concurrent_imap -> concurrent_imap_{mp_pool,thread_pool}
#
# Every other entry reports exactly one row, under the name given here.
#
# Two benchmark directories are deliberately not listed, because neither can
# be installed from a plain checkout: bm_hg_startup needs mercurial and
# bm_yaml needs PyYAML. Their code is kept but they are unreachable until
# someone registers them; they would report "hg_startup" and "yaml".

